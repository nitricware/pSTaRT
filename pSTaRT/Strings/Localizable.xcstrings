      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limitiere die maximale Anzahl an Zeichen in der Identifikation auf eine Zahl von 1 bis 50. Das limitiert auch die Länge der Zeichenketten, die beim Scannen eingelesen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limit the maximum length of the ID input to a number between 1 and 50. This also restricts the length of strings taken from a scanned code."
