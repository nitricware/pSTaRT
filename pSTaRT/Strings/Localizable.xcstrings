    "settings.iCloudSync.confirmOff.button" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausschalten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn Off"
          }
        }
      }
    },
    "settings.iCloudSync.confirmOff.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem nächsten App-Start werden Änderungen nicht mehr mit iCloud synchronisiert, und pSTaRT entfernt seine Daten aus iCloud. Die Daten auf diesem Gerät bleiben erhalten, werden aber nicht mehr in Backups gesichert.\n\nPrüfe vor dem Ausschalten der iCloud-Synchronisierung, ob lokale Gesetze oder die Richtlinien deiner Organisation verlangen, eine Kopie der Daten aufzubewahren – exportiere zum Beispiel vorher eine CSV-Datei.\n\nAndere Geräte, auf denen die iCloud-Synchronisierung noch aktiv ist, können ihre Daten erneut hochladen. Schalte die iCloud-Synchronisierung auf allen Geräten aus, um alle pSTaRT-Daten aus iCloud zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the next app launch, changes are no longer synced to iCloud, and pSTaRT removes its data from iCloud. The data on this device is kept, but no longer included in backups.\n\nBefore turning iCloud Sync off, check whether your local laws or your organization’s policies require you to keep a copy of the data – for example, export a CSV file first.\n\nOther devices with iCloud Sync still on can upload their data again. Turn off iCloud Sync on every device to remove all pSTaRT data from iCloud."
          }
        }
      }
    },
    "settings.iCloudSync.confirmOff.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-Synchronisierung ausschalten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn iCloud Sync Off"
          }
        }
      }
    },
    "settings.iCloudSync.confirmOn.button" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einschalten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn On"
          }
        }
      }
    },
    "settings.iCloudSync.confirmOn.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem nächsten App-Start werden die Daten dieses Geräts in deine private iCloud hochgeladen und mit all deinen Geräten synchronisiert. Daten werden zukünftig auch in Backups aufgenommen.\n\nPrüfe vor dem Einschalten, ob lokale Gesetze und die Richtlinien deiner Organisation das erlauben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the next app launch, the data on this device is uploaded to your private iCloud and synced to all your devices. The data is also included in backups.\n\nBefore turning iCloud Sync on, check whether your local laws and your organization’s policies allow it."
          }
        }
      }
    },
    "settings.iCloudSync.confirmOn.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-Synchronisierung einschalten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn iCloud Sync On"
          }
        }
      }
    },
    "settings.iCloudSync.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pSTaRT kann iCloud verwenden, um Daten zwischen Geräten zu synchronisieren.\n\nPrüfe vor dem Einschalten der iCloud-Synchronisierung, ob lokale Gesetze und die Richtlinien deiner Organisation das erlauben.\n\nPrüfe vor dem Ausschalten der iCloud-Synchronisierung, ob lokale Gesetze oder die Richtlinien deiner Organisation verlangen, eine Kopie der Daten aufzubewahren – exportiere zum Beispiel vorher eine CSV-Datei.\n\nDieser Schalter beeinflusst auch Backups deiner pSTaRT-Daten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pSTaRT can use iCloud to sync data between devices.\n\nBefore turning iCloud Sync on, check whether your local laws and your organization’s policies allow it.\n\nBefore turning iCloud Sync off, check whether your local laws or your organization’s policies require you to keep a copy of the data – for example, export a CSV file first.\n\nThis toggle also affects backups of your pSTaRT data."
          }
        }
      }
    },
    "settings.iCloudSync.label" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisierung mit iCloud"
