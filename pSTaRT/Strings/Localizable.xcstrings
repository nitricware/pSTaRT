    "TIPJAR_INTRODUCTION %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich programmiere die App in meiner Freizeit. Wenn dir gefällt, was du nutzt (inklusive der kostenlosen Updates), freue ich mich über Trinkgeld. Für einen ehrenamtlichen Dienst bei meiner Rettungsdienststelle, erhalte ich %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'm creating this application in my spare time. If you like what you got (including the free upgrades) and want to further support my work, consider leaving a tip. For one voluntary shift at my local ambulance, I receive about %@."
          }
        }
      }
    },
