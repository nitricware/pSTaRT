# fastlane/Snapfile – pSTaRT

devices([
  "iPhone 18 Pro Max",
  "iPhone 18 Pro",
  "iPhone Duo",
  "iPad Pro 13-inch (M5)"
])

languages([
  "de-DE",
  "en-US"
])

project("./pSTaRT.xcodeproj")
scheme("pSTaRT")
only_testing(["pSTaRTUITests/ScreenshotTests/testScreenshots"])

output_directory("./fastlane/screenshots")
clear_previous_screenshots(true)

override_status_bar(true)
erase_simulator(true)
localize_simulator(true)
reinstall_app(true)
app_identifier("com.nitricware.pstart")

stop_after_first_error(true)
number_of_retries(1)
